# Modelo. NAO coloque valores reais aqui -- este arquivo vai para o repositorio.
# Os valores de verdade ficam na Vercel, em Settings -> Environment Variables.

# "sandbox" (testes, dinheiro nenhum) ou "producao" (cobra de verdade)
PAGBANK_AMBIENTE=sandbox

# Token do PagBank. Cada ambiente tem o seu.
PAGBANK_TOKEN_SANDBOX=
PAGBANK_TOKEN_PRODUCAO=

# Para onde o PagBank avisa mudanca de pagamento.
PAGBANK_URL_AVISO=https://nauj-doceria.vercel.app/api/pagbank-aviso
