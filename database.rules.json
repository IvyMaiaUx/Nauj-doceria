{
  "rules": {
    ".read": false,
    ".write": false,
    "products": {
      ".read": true,
      ".write": "auth != null && (auth.token.email === 'maia.operacional@gmail.com' || auth.token.email === 'silvarafaeljuan@gmail.com')"
    },
    "config": {
      ".read": true,
      ".write": "auth != null && (auth.token.email === 'maia.operacional@gmail.com' || auth.token.email === 'silvarafaeljuan@gmail.com')"
    },
    "orders": {
      ".read": "auth != null && (auth.token.email === 'maia.operacional@gmail.com' || auth.token.email === 'silvarafaeljuan@gmail.com')",
      "$orderId": {
        ".write": "(auth != null && (auth.token.email === 'maia.operacional@gmail.com' || auth.token.email === 'silvarafaeljuan@gmail.com')) || (!data.exists() && newData.exists())",
        ".validate": "newData.hasChildren(['id', 'status', 'createdAt'])"
      }
    },
    "order_status": {
      "$orderId": {
        ".read": true,
        ".write": "(auth != null && (auth.token.email === 'maia.operacional@gmail.com' || auth.token.email === 'silvarafaeljuan@gmail.com')) || (!data.exists() && newData.exists())",
        ".validate": "newData.hasChildren(['status'])"
      }
    },
    "coupons": {
      ".read": "auth != null && (auth.token.email === 'maia.operacional@gmail.com' || auth.token.email === 'silvarafaeljuan@gmail.com')",
      ".write": "auth != null && (auth.token.email === 'maia.operacional@gmail.com' || auth.token.email === 'silvarafaeljuan@gmail.com')",
      "$codigo": {
        ".read": true
      }
    },
    "customers": {
      ".read": "auth != null && (auth.token.email === 'maia.operacional@gmail.com' || auth.token.email === 'silvarafaeljuan@gmail.com')",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || (auth.token.email === 'maia.operacional@gmail.com' || auth.token.email === 'silvarafaeljuan@gmail.com'))",
        ".write": "auth != null && (auth.token.email === 'maia.operacional@gmail.com' || auth.token.email === 'silvarafaeljuan@gmail.com')",
        "nome": {
          ".write": "auth != null && auth.uid === $uid"
        },
        "email": {
          ".write": "auth != null && auth.uid === $uid"
        },
        "telefone": {
          ".write": "auth != null && auth.uid === $uid"
        },
        "endereco": {
          ".write": "auth != null && auth.uid === $uid"
        },
        "criadoEm": {
          ".write": "auth != null && auth.uid === $uid"
        },
        "visto": {
          ".write": "auth != null && auth.uid === $uid"
        },
        "historico": {
          ".write": "auth != null && auth.uid === $uid"
        },
        "enderecos": {
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    },
    "avaliacoes": {
      ".read": true,
      "$orderId": {
        ".write": "(auth != null && (auth.token.email === 'maia.operacional@gmail.com' || auth.token.email === 'silvarafaeljuan@gmail.com')) || (!data.exists() && newData.exists())",
        ".validate": "newData.hasChildren(['nota', 'criadoEm']) && newData.child('nota').isNumber() && newData.child('nota').val() >= 1 && newData.child('nota').val() <= 5 && (!newData.hasChild('comentario') || newData.child('comentario').val().length <= 300) && (!newData.hasChild('nome') || newData.child('nome').val().length <= 40)"
      }
    }
  }
}
